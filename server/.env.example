# daily-todo 后端配置（复制为 .env 或直接 export）
PORT=8787
# 前端访问时使用的 Token（务必改成你自己的随机串）
TOKEN=change-me-to-a-long-random-string
# 数据文件位置（默认 ./data.json）
# DATA_FILE=/var/lib/daily-todo/data.json
# 推送：默认开；没有 VAPID 密钥时可先设 false 关闭
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=在此粘贴公钥
VAPID_PRIVATE_KEY=在此粘贴私钥
VAPID_SUBJECT=mailto:you@example.com
